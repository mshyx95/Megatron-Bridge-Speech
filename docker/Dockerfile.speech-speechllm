# Speech-cascades training image built on the maintained `speechllm:latest` base (a security-scanned
# NGC-derived speech image: torch 2.12 / TE 2.15 / apex / flash-attn / triton 3.7, Ubuntu 24.04,
# Python 3.12). Replaces the ad-hoc jing-dev image (which was removed by a registry security cleanup).
#
# Reuse the base's PyTorch/CUDA stack through system site packages. MCore now requires
# Transformer Engine, which uv builds at the official lockfile pin. DeepEP, HybridEP,
# mamba-ssm and flash-mla remain optional and are not needed by the alltoall speech path.

ARG BASE_IMAGE=speechllmregistry.azurecr.io/speechllm:latest
FROM ${BASE_IMAGE} AS speech_speechllm

ARG UV_VERSION=0.9.17
ARG NVTE_WITH_NCCL_EP=0
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV NVTE_SKIP_SUBMODULE_CHECKS_DURING_BUILD=1
WORKDIR /opt/Megatron-Bridge

# The base ships no uv; install a pinned uv for reproducible dependency resolution.
RUN curl -LsSf https://astral.sh/uv/${UV_VERSION}/install.sh | sh && \
    install -m 0755 /root/.local/bin/uv /usr/local/bin/uv

COPY . .

# Install build dependencies before packages with disabled build isolation, including TE.
# The official lockfile controls Transformers, TE and the MLflow security floor.
RUN export TMS_CUDA_MAJOR="$("${CUDA_HOME:-/usr/local/cuda}"/bin/nvcc --version | sed -n 's/.*release \([0-9][0-9]*\).*/\1/p' | head -1)" && \
    test -n "$TMS_CUDA_MAJOR" && \
    uv venv ${UV_PROJECT_ENVIRONMENT} --system-site-packages && \
    uv sync --locked --only-group build && \
    uv sync --locked --no-install-project --extra audio && \
    uv pip install --no-deps --reinstall -e 3rdparty/Megatron-LM && \
    (uv cache prune --ci || true)

# Speech runtime + eval extras not carried in the bridge project deps.
#  - soundfile/whisper_normalizer/kaldialign/editdistance: OpenASR eval + feature IO
#  - blobfile/azure-storage-blob/azure-identity/backoff/unidecode/natsort: vendored
#    streaming ASR data pipeline (blob_chunk_alm) that reads DataSpec chunks from Azure
#    blob mounts. (WhisperProcessor's `openai-whisper` dep is imported lazily and unused
#    on the LogFbank ASR path, so it is intentionally not installed here.)
#  - tilelang: fla's alternate GDN (gated delta net) backward backend. This base ships
#    Triton 3.7.0, still below the 3.7.1 that fla requires on Hopper for the gated chunk_bwd
#    kernel; tilelang provides a correct fallback without disturbing torch's pinned Triton.
RUN uv pip install --python ${UV_PROJECT_ENVIRONMENT}/bin/python \
        soundfile whisper_normalizer kaldialign editdistance \
        blobfile azure-storage-blob azure-identity backoff unidecode natsort \
        tilelang

# AzureML MLflow tracking-store plugin so obs_logging's mlflow.log_metrics reaches the
# AzureML-managed run (metrics tab). Installed with --no-deps: every released azureml-mlflow caps
# mlflow-skinny<3.14, but the bridge pins mlflow>=3.15.1 (CVE-2025-15031); --no-deps keeps the
# synced mlflow intact while still registering the `azureml://` store plugin. Its azureml runtime
# deps are added explicitly.
RUN uv pip install --python ${UV_PROJECT_ENVIRONMENT}/bin/python --no-deps azureml-mlflow && \
    uv pip install --python ${UV_PROJECT_ENVIRONMENT}/bin/python \
        azureml-core azure-common azure-mgmt-core jsonpickle msrest oauthlib requests-oauthlib

# Empty overlay marker so the cluster wrapper (run_speech_cascades_stage1.sh) skips its runtime pip
# bootstrap: transformers / nvidia-resiliency-ext are already baked in, and the bootstrap would
# otherwise DOWNGRADE transformers and break the stack.
RUN mkdir -p /opt/bridge-overlay && touch /opt/bridge-overlay/.done

ENV PATH="/opt/venv/bin:${PATH}"
ENV PYTHONPATH="/opt/Megatron-Bridge/src:/opt/Megatron-Bridge/3rdparty/Megatron-LM"
